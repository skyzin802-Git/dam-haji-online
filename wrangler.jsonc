{
  "name": "dam-haji-online",
  "main": "src/worker.js",
"assets": {
  "directory": "./",
  "binding": "ASSETS",
  "run_worker_first": true
},
  "compatibility_date": "2026-10-28",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
